# Copy to .env and fill in. This file documents every variable the code reads.
# On Render, set these in the service's Environment tab instead.

# ---- Core (required) ----
NODE_ENV=production
# Render injects PORT automatically; locally use 5001 (both frontends expect it)
PORT=5001
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/feauage
JWT_SECRET=<64+ random hex chars>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<a DIFFERENT 64+ random hex string>
JWT_REFRESH_EXPIRES_IN=30d

# ---- URLs ----
# Comma-separated browser origins allowed to call this API. Include BOTH
# frontends. Without it every origin is accepted.
CORS_ORIGINS=https://your-shop.onrender.com,https://your-admin.onrender.com
FRONTEND_URL=https://your-shop.onrender.com
CLIENT_URL=https://your-shop.onrender.com
SERVER_URL=https://your-api.onrender.com
WEBSITE_URL=https://your-shop.onrender.com

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CALLBACK_URL=https://your-api.onrender.com/api/v1/payments/callback

# ---- Image uploads ----
# ImgBB: the simplest option — one key, no bucket or IAM user needed.
# Takes precedence over the AWS settings below when set.
IMGBB_API_KEY=

# ---- Object storage (image uploads, alternative to ImgBB) ----
# Without all three, uploads return a clear 503 and admins cannot add images.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_SES_SENDER_EMAIL=

# ---- Email ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Feauag
BREVO_CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Shipping (Shiprocket) ----
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=400001
SHIPROCKET_WEBHOOK_SECRET=

# ---- Seed script only ----
ADMIN_EMAIL=admin@jewellery.com
ADMIN_PASSWORD=
